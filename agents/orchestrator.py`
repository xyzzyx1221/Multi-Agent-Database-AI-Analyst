import os
from typing import Annotated, TypedDict, Union, List, Dict, Any
from langgraph.graph import StateGraph, END
from langgraph.graph.message import add_messages
from langgraph.checkpoint.memory import MemorySaver

from agents.schema_agent import schema_agent
from agents.query_agent import query_agent
from agents.guardrail_agent import guardrail_agent
from agents.insight_agent import insight_agent
from agents.viz_report_agent import viz_report_agent
from tools.db_executor import executor
from memory.conversation_store import conversation_store
from memory.reference_resolver import reference_resolver
from groq import Groq
from dotenv import load_dotenv

load_dotenv()

GROQ_API_KEY = os.getenv("GROQ_API_KEY")

# Define the state of our conversation/process
class AgentState(TypedDict):
    messages: Annotated[list, add_messages]
    session_id: str
    question: str
    sql: str
    schema_context: str
    retry_count: int
    current_task_index: int
    tasks: List[Dict[str, Any]]
    task_results: List[Dict[str, Any]]
    is_safe: bool
    guardrail_feedback: str
    final_result: Union[list, str, None]

class Orchestrator:
    def __init__(self):
        self.client = Groq(api_key=GROQ_API_KEY)
        
        workflow = StateGraph(AgentState)

        # Nodes
        workflow.add_node("resolve_references", self.resolve_references_node)
        workflow.add_node("planner", self.planner_node)
        workflow.add_node("fetch_schema", self.fetch_schema_node)
        workflow.add_node("generate_sql", self.generate_sql_node)
        workflow.add_node("validate_sql", self.validate_sql_node)
        workflow.add_node("execute_sql", self.execute_sql_node)
        workflow.add_node("generate_insight", self.generate_insight_node)
        workflow.add_node("generate_report", self.generate_report_node)

        # Edges
        workflow.set_entry_point("resolve_references")
        workflow.add_edge("resolve_references", "planner")
        workflow.add_edge("planner", "fetch_schema")
        workflow.add_edge("fetch_schema", "generate_sql")
        workflow.add_edge("generate_sql", "validate_sql")

        # Inner Loop Router (Retry Logic)
        workflow.add_conditional_edges(
            "validate_sql",
            self.should_retry,
            {
                "retry": "generate_sql",
                "proceed": "execute_sql",
                "end": END
            }
        )

        # Outer Loop Router (Task Logic)
        workflow.add_conditional_edges(
            "execute_sql",
            self.should_next_task,
            {
                "next_task": "generate_sql",
                "finish": "generate_insight"
            }
        )

        # Final path
        workflow.add_conditional_edges(
            "generate_insight",
            self.should_viz,
            {
                "viz": "generate_report",
                "end": END
            }
        )
        workflow.add_edge("generate_report", END)

        # Use MemorySaver for session-based HITL interrupts
        self.memory = MemorySaver()
        self.app = workflow.compile(checkpointer=self.memory, interrupt_before=["execute_sql", "generate_report"])

    def resolve_references_node(self, state: AgentState):
        print("[Orchestrator] Resolving references...")
        history = conversation_store.load_history(state["session_id"])
        is_follow_up, resolved_question = reference_resolver.resolve(state["question"], history)
        
        if is_follow_up:
            print(f"  - Follow-up detected! Rewritten to: {resolved_question}")
        else:
            print("  - New topic detected.")
            
        return {"question": resolved_question}

    def planner_node(self, state: AgentState):
        print("[Orchestrator] Planning tasks...")
        schema = schema_agent.get_relevant_schema(state["question"])
        
        prompt = f"""You are a Task Planner. Your goal is to break complex user requests into a list of independent SQL tasks.
User Question: {state['question']}
Schema: {schema}

CRITICAL RULES:
1. If the user asks for a 'report', 'summary', or mentions multiple different metrics (e.g., sales AND marketing), you MUST break it into multiple separate tasks.
2. Do NOT try to write one giant query with multiple JOINs for different business entities. Create separate tasks for each entity.
3. Use dates for 2025 or 2026.

Return a JSON object with a key 'tasks' which is a list of tasks. Each task must have 'goal' and 'type'.
Example: {{"tasks": [
    {{'goal': 'Get total sales for January 2025', 'type': 'sql'}},
    {{'goal': 'Get total marketing spend for January 2025', 'type': 'sql'}}
]}}
Return ONLY the JSON.
"""
        response = self.client.chat.completions.create(
            model="openai/gpt-oss-120b",
            messages=[{"role": "user", "content": prompt}],
            response_format={"type": "json_object"}
        )
        import json
        plan_data = json.loads(response.choices[0].message.content)
        tasks = plan_data.get("tasks", [])
        
        return {
            "tasks": tasks, 
            "current_task_index": 0, 
            "task_results": [],
            "retry_count": 0
        }

    def fetch_schema_node(self, state: AgentState):
        print("[Orchestrator] Fetching schema context...")
        context = schema_agent.get_relevant_schema(state["question"])
        return {"schema_context": context}

    def generate_sql_node(self, state: AgentState):
        idx = state["current_task_index"]
        task = state["tasks"][idx]
        
        retry_count = state.get("retry_count", 0)
        if state.get("guardrail_feedback"):
            retry_count += 1
            
        print(f"[Orchestrator] Generating SQL for Task {idx+1}: {task['goal']} (Attempt {retry_count+1}/3)...")
        
        feedback = state.get("guardrail_feedback", "")
        prompt_ext = f"\n\nPrevious error: {feedback}" if retry_count > 0 else ""
        
        sql = query_agent.generate_sql(task['goal'] + prompt_ext, state["schema_//context"])
        return {"sql": sql, "retry_count": retry_count}

    def validate_sql_node(self, state: AgentState):
        print("[Orchestrator] Validating SQL...")
        is_safe, reasoning = guardrail_agent.validate_sql(state["sql"], state["question"])
        return {"is_safe": is_safe, "guardrail_feedback": reasoning}

    def should_retry(self, state: AgentState):
        if state["is_safe"]:
            return "proceed"
        
        if "NEEDS_CONFIRMATION" in state.get("guardrail_feedback", "").upper():
            # In a web app, we return "proceed" but the graph's 
            # interrupt_before=["execute_sql"] will pause the execution here.
            return "proceed" 

        if state["retry_count"] < 2:
            return "retry" 
        return "end"

    def execute_sql_node(self, state: AgentState):
        print("[Orchestrator] Executing SQL...")
        try:
            res = executor.execute(state["sql"], validated=True)
            current_results = state.get("task_results", [])
            current_results.append({"task": state["tasks"][state["current_task_index"]]["goal"], "result": res})
            
            conversation_store.save_turn(state["session_id"], {
                "question": state["question"], "sql": state["sql"], "final_result": str(res)
            })
            
            return {
                "task_results": current_results, 
                "retry_count": 0, 
                "current_task_index": state["current_task_index"] + 1
            }
        except Exception as e:
            return {"final_result": f"Error: {str(e)}"}

    def should_next_task(self, state: AgentState):
        if state["current_task_index"] < len(state["tasks"]):
            return "next_task"
        return "finish"

    def generate_insight_node(self, state: AgentState):
        print("[Orchestrator] Generating final insight...")
        results = state["task_results"]
        insight = insight_agent.generate_insight(state["question"], results, state["schema_context"])
        return {"final_result": insight}

    def generate_report_node(self, state: AgentState):
        print("[Orchestrator] Generating detailed report & chart...")
        report = viz_report_agent.generate_report(state["question"], state["task_results"])
        return {"final_//result": report}

    def should_viz(self, state: AgentState):
        if len(state["tasks"]) > 7 or "report" in state["question"].lower():
            return "viz"
        return "end"

    def run(self, question: str, session_id: str = "default_user"):
        config = {"configurable": {"thread_id": session_id}}
        inputs = {"question": question, "session_id": session_id, "messages": [], "retry_count": 0}
        
        final_state = self.app.invoke(inputs, config=config)
        return final_state

    def resume(self, session_id: str):
        config = {"configurable": {"thread_id": session_id}}
        return self.app.invoke(None, config=config)

# Singleton instance
orchestrator = Orchestrator()
